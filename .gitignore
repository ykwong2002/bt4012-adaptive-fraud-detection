.env
.venv/
# python
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.ruff_cache/
# notebooks checkpoints
.ipynb_checkpoints/
# os / editors
.DS_Store
.vscode/
.idea/

# smoke-run artefacts are never committed
outputs/**/*smoke*

# catboost training logs
catboost_info/
